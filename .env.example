# =============================================
# DEEPSCHOLAR FRONTEND - ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env.local for local development (npm run dev)
# For Docker local: env vars are set in docker-compose.yml automatically
# For Production (Vercel): set these in Vercel Dashboard → Settings → Environment Variables

# ============ SERVER-SIDE ONLY (route handlers) ============
# Used by Next.js API routes on the server — NOT exposed to browser
BACKEND_URL=http://localhost:8000/api/v1
AI_URL=http://localhost:8001/api

# ============ PUBLIC (browser-accessible) ============
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
