# ============================================================
# DeepScholar Frontend — Environment Variables
# Copy file này thành .env.local để chạy local
# ============================================================

# ---- Backend (Django) ----
BACKEND_URL=http://localhost:8000/api/v1

# ---- AI Service (FastAPI) ----
# Local bare (không Docker): http://localhost:8001/api
# Local Docker (Frontend trong container): http://host.docker.internal:8001/api
AI_URL=http://localhost:8001/api

# ---- OAuth ----
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
